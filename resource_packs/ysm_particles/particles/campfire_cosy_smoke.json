{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ysm:campfire_cosy_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/campfire_smoke"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_expression": {},
      "minecraft:emitter_rate_manual": {
        "max_particles": 200
      },
      "minecraft:emitter_shape_custom": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 5
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.random(-0.08, 0.08)",
          -0.0012,
          "math.random(-0.08, 0.08)"
        ]
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.125,
        "coefficient_of_restitution": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 + 0.3 * variable.particle_random_1",
          "0.3 + 0.3 * variable.particle_random_1"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_height": 12,
          "uv": [
            0,
            "math.floor(variable.particle_random_2 * 12)"
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.max(0, 0.9 - 0.015 * math.max(0, math.floor(variable.particle_age * 20 + 0.0001) - math.max(1, math.round(variable.particle_lifetime * 20) - 60) + 1))"
        ]
      }
    }
  }
}
